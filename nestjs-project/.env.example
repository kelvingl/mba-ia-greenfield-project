# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube" <noreply@streamtube.com>

# Object storage (MinIO in dev/test, S3 in production)
# Internal host uses the Compose service name; S3_PUBLIC_ENDPOINT is the only
# host-reachable URL because the browser consumes the presigned URLs.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=streamtube
S3_DELIVERY_URL_TTL_SECONDS=900
STORAGE_WEBHOOK_TOKEN=change-me-webhook-token

# Queue (BullMQ on Redis)
REDIS_HOST=redis
REDIS_PORT=6379
# QUEUE_PREFIX isolates BullMQ keys (tests set their own)
QUEUE_PREFIX=bull
VIDEO_PROCESSING_BACKOFF_MS=5000
# Scratch directory of the video worker for downloaded originals (default: OS temp dir)
# PROCESSING_TMP_DIR=/tmp/video-processing
